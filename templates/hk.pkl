// TSU + HK Integration Template
// This template configures HK to run TSU hooks in parallel for Dart/Flutter projects
//
// For more information:
// - TSU: https://github.com/bestdan/tsu
// - HK: https://github.com/jdx/hk
//
// Customize this file to fit your project's needs.

amends "package://github.com/jdx/hk/releases/download/v1.23.0/hk@1.23.0#/Config.pkl"

// Fix actions run their tools directly, so they clear git's repository variables
// (GIT_DIR in a linked worktree) first, as the `tsu hook` commands do.
local clear_git_env = "unset $(git rev-parse --local-env-vars); "

// Define TSU hooks as individual steps for parallel execution
local tsu_hooks = new Mapping<String, Step> {
    // Dart format check - ensures code is properly formatted
    ["dart-format"] {
        glob = List("*.dart")
        check = "tsu hook format check"
        fix = clear_git_env + "dart format ."
        batch = true
    }
    
    // Dart analysis check - runs dart analyze on changed packages
    ["dart-analysis"] {
        glob = List("*.dart")
        check = "tsu hook analysis check"
        batch = true
    }
    
    // Dart fix check - ensures all auto-fixable lints are applied
    ["dart-fix"] {
        glob = List("*.dart")
        check = "tsu hook fix check"
        fix = clear_git_env + "dart fix --apply"
        batch = true
    }
    
    // DCM analyze check - runs DCM static analysis (if DCM is installed)
    ["dcm-analyze"] {
        glob = List("*.dart")
        check = "tsu hook dcm analyze check"
        batch = true
    }
    
    // DCM fix check - ensures DCM auto-fixes are applied (if DCM is installed)
    ["dcm-fix"] {
        glob = List("*.dart")
        check = "tsu hook dcm fix check"
        fix = clear_git_env + "dcm fix ."
        batch = true
    }
    
    // GraphQL codegen check - ensures GraphQL fakes are up to date (if using GraphQL)
    ["graphql"] {
        glob = List("*.graphql")
        check = "tsu hook graphql check"
    }
}

// Configure git hooks
hooks {
    // Pre-commit: Fast checks with auto-fix enabled
    ["pre-commit"] {
        fix = true
        stash = "patch-file" // Stash unstaged changes to avoid conflicts
        steps {
            ["dart-format"] = tsu_hooks["dart-format"]
            ["dart-fix"] = tsu_hooks["dart-fix"]
            ["dcm-fix"] = tsu_hooks["dcm-fix"]
        }
    }
    
    // Pre-push: Comprehensive checks without auto-fix
    ["pre-push"] {
        steps {
            ["dart-format"] = tsu_hooks["dart-format"]
            ["dart-analysis"] = tsu_hooks["dart-analysis"]
            ["dart-fix"] = tsu_hooks["dart-fix"]
            ["dcm-analyze"] = tsu_hooks["dcm-analyze"]
            ["dcm-fix"] = tsu_hooks["dcm-fix"]
            ["graphql"] = tsu_hooks["graphql"]
        }
    }
    
    // Manual fix command: Run all checks with auto-fix
    ["fix"] {
        fix = true
        steps = tsu_hooks
    }
    
    // Manual check command: Run all checks without auto-fix
    ["check"] {
        steps = tsu_hooks
    }
}

// Configuration options
// Suppress warnings about missing profiles (like DCM or GraphQL)
// since these are optional dependencies
hide_warnings = List("missing-profiles")
